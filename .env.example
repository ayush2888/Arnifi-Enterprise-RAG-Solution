# AWS — local/dev credentials (on Lambda use the execution role instead)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1

# Bedrock may use a different region than Lambda (e.g. models enabled in us-east-1)
BEDROCK_REGION=us-east-1
BEDROCK_CHAT_MODEL=amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# Pinecone — bring-your-own-vectors index (1024-d, no hosted embedding model)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=arnifi-rag-titan
PINECONE_ENVIRONMENT=us-east-1

# Google Drive — service account JSON path + root folder to sync
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/rag-arnifi.json
DRIVE_ROOT_FOLDER_ID=your_drive_folder_id

# Periskope WhatsApp — API key + org phone for x-phone header
PERISKOPE_API_KEY=your_periskope_api_key
PERISKOPE_PHONE=919999999999

# Optional — WCS ERP date-range WhatsApp summary proxy target
# WCS_ERP_SUMMARY_URL=https://wcs.erp.arnifi.com/api/summary

# Supabase — same project as the dashboard (usage metering + JWT)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key
