# AWS — local/dev credentials (on Lambda use the execution role instead)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1

# Bedrock may use a different region than Lambda (e.g. models enabled in us-east-1)
BEDROCK_REGION=us-east-1
BEDROCK_CHAT_MODEL=amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# Pinecone — bring-your-own-vectors index (1024-d, no hosted embedding model)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=arnifi-rag-titan
PINECONE_ENVIRONMENT=us-east-1
