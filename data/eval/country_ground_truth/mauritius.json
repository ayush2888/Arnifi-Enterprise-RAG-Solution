    "keySellingPoints": [
      {
        "id": 54,
        "value": "Gateway to Africa & Asia\nMauritius serves as a strategic bridge between Africa and Asia, enabling businesses to expand efficiently into emerging and high-growth markets\n"
      },
      {
        "id": 58,
        "value": "Favourable Tax Regime\nLow corporate tax rates with partial exemptions and extensive double taxation treaties make Mauritius highly attractive for global structuring\n"
      },
      {
        "id": 57,
        "value": "Investor-Friendly Regulations\nTransparent legal framework, ease of doing business, and strong investor protection policies support international companies\n"
      },
      {
        "id": 55,
        "value": "Global Business Hub\nWidely used for holding companies, investment funds, and international trading due to its reputation and regulatory clarity\n"
      },
      {
        "id": 56,
        "value": "Skilled Bilingual Workforce\nA well-educated workforce fluent in English and French supports international operations and cross-border business\n"
      },
      {
        "id": 59,
        "value": "Stable Political & Economic Environment\nConsistent governance, strong institutions, and economic stability provide long-term confidence for investors\n"
      }
