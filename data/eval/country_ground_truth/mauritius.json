    "FAQs": [
      {
        "id": 58,
        "question": "What types of business setups are available in Mauritius?\n",
        "answer": "Businesses can be set up as Global Business Companies (GBC), Authorized Companies, or Domestic Companies depending on operational scope\n"
      },
      {
        "id": 59,
        "question": "Is 100% foreign ownership allowed in Mauritius?\n",
        "answer": "Yes, Mauritius allows full foreign ownership in most sectors without significant restrictions\n"
      },
      {
        "id": 60,
        "question": "What is the corporate tax rate in Mauritius?\n",
        "answer": "The standard corporate tax rate is 15%, with partial exemptions potentially reducing the effective rate\n"
      },
      {
        "id": 61,
        "question": "How long does it take to set up a company?\n",
        "answer": "Company incorporation typically takes 5 to 10 working days, depending on approvals and documentation\n"
      }
