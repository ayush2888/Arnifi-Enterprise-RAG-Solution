    "FAQs": [
      {
        "id": 75,
        "question": "What types of business entities are available in Ireland?\n",
        "answer": " Businesses can register as private limited companies (LTD), designated activity companies (DAC), branches, or partnerships\n"
      },
      {
        "id": 74,
        "question": "What is the corporate tax rate in Ireland?\n",
        "answer": "The standard rate is 12.5% for trading income, with a 15% rate applying to large multinational groups under global tax rules\n"
      },
      {
        "id": 72,
        "question": "How long does it take to set up a company?\n",
        "answer": " Company formation typically takes 5 to 10 working days\n"
      },
      {
        "id": 71,
        "question": "Do I need a local director?\n",
        "answer": "Yes, at least one EEA-resident director is generally required, or a bond must be secured\n"
      },
      {
        "id": 73,
        "question": "Is Ireland good for startups?\n",
        "answer": " Yes, especially for tech, SaaS, fintech, and export-oriented businesses targeting Europe\n"
      }
