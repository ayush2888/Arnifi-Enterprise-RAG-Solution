    "keySellingPoints": [
      {
        "id": 60,
        "value": "CEPA: The China Door\nA free trade agreement that only Hong Kong gets. Zero tariffs on exports into Mainland China. Only a few jurisdictions have this card.\n"
      },
      {
        "id": 61,
        "value": "Government-Backed Sectors\nFinancial services. ICT. Transport and logistics. InvestHK pours real support into these. Infrastructure. Fast tracks. Actual government support behind your setup.\n"
      },
      {
        "id": 63,
        "value": "SME Support That Functions\nHKTDC SME Centre handles trade data, business matching, and export guidance. Not brochures. Operational help. Centralized and funded.\n"
      },
      {
        "id": 64,
        "value": "Tax System Built to Compete\n8.25 percent on the first HKD 2 million of profits. 16.5 percent after that. Offshore income stays untaxed. The territorial system stays clean.\n"
      },
      {
        "id": 65,
        "value": "Supply Chain Command Center\nPearl River Delta connectivity. Direct China Customs data integration. Major trade events on your doorstep. This is where sourcing gets done.\n"
      },
      {
        "id": 62,
        "value": "Full Ownership. Common Law.\nZero local shareholder requirements with total foreign control. Courts you can trust. English common law and the strong legal system.\n"
      }
    ],
    "prosCons": [],
    "FAQs": [
      {
        "id": 81,
        "question": "What is CEPA and who qualifies?\n",
        "answer": "CEPA is a free trade deal between Mainland China and Hong Kong. Qualifying Hong Kong companies get preferential access, often zero tariffs, on goods and services entering the mainland. Few jurisdictions have anything close.\n"
      },
      {
        "id": 82,
        "question": "What government support exists for new businesses?",
        "answer": "InvestHK offers tailored help for foreign companies in priority sectors like ICT and financial services. The HKTDC SME Centre handles business matching, market research, and export marketing. Both are operational, not decorative.\n"
      },
      {
        "id": 83,
        "question": "Do I need a local director?\n",
        "answer": "No. Directors can live anywhere and hold any passport. The one local requirement is a Company Secretary based in Hong Kong.\n"
      },
      {
        "id": 85,
        "question": "What's the actual tax rate?",
        "answer": "Two tiers. 8.25 percent on the first HKD 2 million of assessable profits. 16.5 percent on everything above that threshold. Offshore income sits outside the net entirely."
      },
      {
        "id": 84,
        "question": "Are annual audits mandatory?\n",
        "answer": "Yes. Every Hong Kong private limited company gets audited by a local CPA. Active Hong Kong private limited companies are generally required to undergo annual audits. The filing deadline doesn't move.\n"
      }
    ],
    "marketInsights": [
      {
        "id": 19,
        "title": "Deepening GBA Integration",
        "text": "WMC 2.0 opens wider channels for cross-boundary wealth flows. New data frameworks sit alongside it. Together, they lock Hong Kong in as the Greater Bay Area's main financial hub.\n",
        "tag": "Economy",
        "date": "2024-02-26"
      },
      {
        "id": 20,
        "title": "Aggressive Enterprise Incentives",
        "text": "The 2026-27 Budget slashed tax rates to 5 percent for priority industries. OASES got a wider mandate to pull in foreign firms and smooth their market entry.",
        "tag": "Regulation",
        "date": "2026-02-25"
      }
    ],
    "processStep": [
      {
        "id": 86,
        "question": "Lock Down the Structure\n",
        "answer": "A Private Limited Company tag covers most needs. Set your share capital. Name your directors and shareholders. Directors and shareholders do not need Hong Kong residency.\t\n"
      },
      {
        "id": 87,
        "question": "File the Paperwork\n",
        "answer": "Incorporation forms hit the Companies Registry. The Business Registration Certificate application goes to the Inland Revenue Department. Both filed together with Identity documents attached.\n"
      },
      {
        "id": 89,
        "question": "Build the Framework\n",
        "answer": "Appoint a Company Secretary (mandatory and must be Hong Kong-based). Secure a registered office address and start the bank account process. This step usually drags the longest, which is exactly why Arnifi leverages local banking relationships to push it through."
      },
      {
        "id": 88,
        "question": "Keep It Compliant\n",
        "answer": "Annual return filing. BRC renewal. Significant Controllers Register stays updated. Audited financial statements submitted on time. Miss these and the penalties stack fast.\n"
      }
    ],
