    "FAQs": [
      {
        "id": 1,
        "question": "What types of business setups are available in the UAE?",
        "answer": "Businesses can be established in mainland, free zone, or offshore jurisdictions. Each option offers different benefits in terms of ownership, taxation, and operational flexibility depending on business needs."
      },
      {
        "id": 4,
        "question": "Is 100% foreign ownership allowed in the UAE?",
        "answer": "Yes, 100% foreign ownership is allowed in most mainland sectors and all free zones, eliminating the need for a local sponsor in many cases."
      },
      {
        "id": 3,
        "question": "What is the corporate tax rate in the UAE?",
        "answer": "The UAE applies a 9% corporate tax on taxable profits exceeding AED 375,000, while smaller businesses may benefit from relief schemes."
      },
      {
        "id": 2,
        "question": "How long does it take to set up a company in the UAE?\n",
        "answer": "Business setup can typically be completed within a few days to a couple of weeks, depending on the jurisdiction and type of license."
      },
      {
        "id": 5,
        "question": "Do I need a physical office to start a business?",
        "answer": "Some jurisdictions require a physical office, while many free zones offer flexible desk or virtual office solutions for startups and small businesses."
      }
    ],
