    "FAQs": [
      {
        "id": 22,
        "question": "What is MISA, and why is it important?\n",
        "answer": "The Ministry of Investment of Saudi Arabia (MISA) regulates foreign investment and provides licenses that allow international businesses to operate legally in the Kingdom."
      },
      {
        "id": 19,
        "question": "Can foreigners own 100% of a business in Saudi Arabia?",
        "answer": "Yes, foreign investors can own 100% of businesses in many sectors, subject to approvals and activity-specific regulations."
      },
      {
        "id": 21,
        "question": "What is Saudisation and how does it affect businesses?",
        "answer": "Saudisation requires companies to hire a certain percentage of Saudi nationals, impacting workforce planning and compliance obligations."
      },
      {
        "id": 20,
        "question": "How long does it take to set up a company in Saudi Arabia?",
        "answer": "Business setup timelines vary but typically range from a few weeks to a couple of months, depending on approvals and sector requirements."
      },
      {
        "id": 23,
        "question": "What are the key sectors for investment in Saudi Arabia?",
        "answer": "Key sectors include tourism, technology, logistics, manufacturing, and renewable energy, driven by Vision 2030 initiatives."
      }
